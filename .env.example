# =============================================================================
# LuminaQuest Environment Configuration
# =============================================================================
# Copy this file to .env and update with your settings
#
# For Docker Compose:
#   docker compose up -d
#
# For Development:
#   npm run dev (requires mongodb running via docker compose up -d mongo)
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/luminaquest
# For Docker Compose, use: mongodb://mongo:27017/luminaquest

MONGO_CONNECT_RETRIES=5
MONGO_CONNECT_RETRY_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Authentication (REQUIRED - minimum 24 characters)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-strong-secret-min-24-chars

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173
# For Docker Compose, use: http://localhost:8080

CORS_ALLOW_NO_ORIGIN=false

# -----------------------------------------------------------------------------
# Request Limits
# -----------------------------------------------------------------------------
REQUEST_JSON_LIMIT=256kb

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Options: lmstudio, openrouter
LLM_PROVIDER=lmstudio

# LMStudio (Local Inference - Recommended for development)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# For Docker Compose, use: http://host.docker.internal:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=google/gemma-3-4b

# OpenRouter (External API - Good for production without local GPU)
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=LuminaQuest
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# -----------------------------------------------------------------------------
# Optional: Langfuse Tracing
# -----------------------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Frontend Configuration (for Vite dev server)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
